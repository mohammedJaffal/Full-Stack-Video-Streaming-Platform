---
import Layout from '../layouts/Layout.astro';
import ContentCard from '../components/ContentCard.astro';
import { API_URL } from '../lib/api';
let items = [];
let error = '';
try {
  const response = await fetch(`${API_URL}/api/content`);
  if (!response.ok) throw new Error();
  items = await response.json();
} catch {
  error = 'The catalog service is temporarily unavailable.';
}
const featured = items[0];
const recent = items.slice(0, 6);
const documentaries = items.filter(item => item.category_name === 'Documentary');
const learning = items.filter(item => ['Technology', 'Education'].includes(item.category_name));
---
<Layout title="StreamForge · Secure HLS Streaming">
  {featured ? (
    <section class="hero" style={`background-image:linear-gradient(90deg,rgba(10,10,11,.94),rgba(10,10,11,.16)),url('${featured.backdrop_url}')`}>
      <div class="hero-copy">
        <span class="hero-kicker">Featured</span>
        <h1>{featured.title}</h1>
        <p>{featured.description}</p>
        <div class="meta"><span>{featured.category_name}</span><span>{featured.release_year}</span><span>{Math.round(featured.duration_seconds / 60)} min</span></div>
        <div class="actions"><a class="button" href={`/watch/${featured.slug}`}>▶ Watch now</a><a class="button ghost" href={`/content/${featured.slug}`}>View details</a></div>
      </div>
    </section>
  ) : (
    <section class="hero"><div class="hero-copy"><h1>StreamForge</h1><p>{error}</p></div></section>
  )}

  {recent.length > 0 && <section class="page-section page-shell"><div class="section-heading"><div><h2>Recently added</h2></div><a class="section-link" href="/explore">Browse all →</a></div><div class="card-grid">{recent.map(item => <ContentCard item={item} />)}</div></section>}
  {documentaries.length > 0 && <section class="page-section page-shell content-row"><div class="section-heading"><h2>Documentaries</h2></div><div class="card-grid">{documentaries.map(item => <ContentCard item={item} />)}</div></section>}
  {learning.length > 0 && <section class="page-section page-shell content-row"><div class="section-heading"><h2>Technology & education</h2></div><div class="card-grid">{learning.map(item => <ContentCard item={item} />)}</div></section>}
</Layout>
