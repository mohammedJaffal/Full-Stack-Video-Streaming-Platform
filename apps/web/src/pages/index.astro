---
const api = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
let items = [];
try { const response = await fetch(`${api}/api/content`); if (response.ok) items = await response.json(); } catch {}
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>StreamForge</title><style>body{margin:0;background:#090b10;color:#f7f8fa;font-family:Inter,system-ui}main{max-width:1200px;margin:auto;padding:32px}.hero{padding:72px 40px;border-radius:24px;background:linear-gradient(90deg,#111827,transparent),url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1600&q=80') center/cover}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}.card{background:#151923;border-radius:16px;overflow:hidden;color:inherit;text-decoration:none}.card img{width:100%;aspect-ratio:2/3;object-fit:cover}.card div{padding:16px}input{width:100%;max-width:420px;padding:14px 16px;border-radius:12px;border:1px solid #303747;background:#10141c;color:white;margin:28px 0}</style></head><body><main><section class="hero"><p>Featured documentary</p><h1>Mountain Horizons</h1><p>Secure adaptive HLS playback, subtitles, and responsive controls.</p><a href="/watch/1" style="color:white">Play now →</a></section><input id="search" placeholder="Search the catalog"/><h2>Recently added</h2><section class="grid" id="catalog">{items.map((item:any)=><a class="card" data-title={item.title.toLowerCase()} href={`/details/${item.slug}`}><img src={item.poster_url}/><div><strong>{item.title}</strong><p>{item.category}</p></div></a>)}</section></main><script>const input=document.querySelector('#search');input?.addEventListener('input',e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('[data-title]').forEach(el=>el.style.display=el.dataset.title.includes(q)?'block':'none')});</script></body></html>
