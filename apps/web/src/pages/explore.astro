---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Browse · StreamForge">
  <section class="page-section page-shell browse-page">
    <div class="browse-heading">
      <div><p class="eyebrow">Library</p><h1>Browse</h1><p class="muted">Find titles by name, description, or category.</p></div>
    </div>
    <div class="filter-bar">
      <input id="search" placeholder="Search titles or descriptions" aria-label="Search catalog" />
      <select id="category" aria-label="Filter by category"><option value="">All categories</option></select>
      <select id="sort" aria-label="Sort catalog"><option value="recent">Recently added</option><option value="title">Title A–Z</option></select>
    </div>
    <p id="state" class="muted">Loading catalog…</p>
    <div id="results" class="catalog-grid"></div>
  </section>
</Layout>
<script>
  const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
  const search = document.querySelector('#search');
  const category = document.querySelector('#category');
  const sort = document.querySelector('#sort');
  const results = document.querySelector('#results');
  const state = document.querySelector('#state');
  const escape = value => String(value).replace(/[&<>'"]/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[character]));

  async function loadCategories() {
    try {
      const response = await fetch(`${API}/api/categories`);
      if (!response.ok) throw new Error();
      for (const item of await response.json()) category.insertAdjacentHTML('beforeend', `<option value="${escape(item.slug)}">${escape(item.name)}</option>`);
    } catch {}
  }

  async function load() {
    state.textContent = 'Loading catalog…';
    results.innerHTML = '';
    const params = new URLSearchParams({ q: search.value, category: category.value, sort: sort.value });
    try {
      const response = await fetch(`${API}/api/content?${params}`);
      if (!response.ok) throw new Error();
      const items = await response.json();
      results.innerHTML = items.map(item => `
        <a class="content-card" href="/content/${escape(item.slug)}">
          <div class="poster-wrap"><img src="${escape(item.poster_url)}" alt="${escape(item.title)} poster"><span class="card-overlay" aria-hidden="true">▶</span></div>
          <div class="card-copy"><h3>${escape(item.title)}</h3><p>${escape(item.category_name)} · ${item.release_year} · ${Math.round(item.duration_seconds / 60)} min</p></div>
        </a>`).join('');
      state.textContent = items.length ? `${items.length} title${items.length === 1 ? '' : 's'}` : '';
      if (!items.length) {
        results.innerHTML = '<div class="empty-state"><div><strong>No matches found</strong><span>Try another search or clear the filters.</span><div class="empty-state-actions"><button id="clearFilters" class="ghost">Clear filters</button></div></div></div>';
        document.querySelector('#clearFilters')?.addEventListener('click', () => { search.value = ''; category.value = ''; sort.value = 'recent'; load(); });
      }
    } catch {
      state.textContent = '';
      results.innerHTML = '<div class="error-state"><div><strong>Catalog could not be loaded</strong><span>Check the API connection and refresh the page.</span></div></div>';
    }
  }

  let timer;
  search.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(load, 250); });
  category.addEventListener('change', load);
  sort.addEventListener('change', load);
  loadCategories().then(load);
</script>
